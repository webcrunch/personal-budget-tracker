# Kopiera till .env och fyll i. .env checkas aldrig in.

# --- Databas ---
POSTGRES_DB=budget_app
POSTGRES_USER=postgresql
POSTGRES_PASSWORD=
# Samma värden som ovan, i formatet som API:t läser
CONNECTION_STRING=Host=db;Port=5432;Database=budget_app;Username=postgresql;Password=

# --- AI (Ollama) ---
OLLAMA_URL=http://host.docker.internal:11435
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=minicpm-v:latest

# --- Utveckling ---
ASPNETCORE_ENVIRONMENT=Development
# pgAdmin startar bara med: docker compose --profile dev up
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# --- Produktion (skrivs av deploy-workflowen från Vault) ---
# Inloggningen framför sajten, skapad med: htpasswd -nbB <user> <lösenord>
# Inom enkla citattecken, eftersom hashen innehåller $.
# BUDGET_BASIC_AUTH='user:$2y$05$...'
