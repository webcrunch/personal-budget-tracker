# Kopiera till .env för lokal utveckling och välj egna lösenord. I produktion skriver deployen
# .env från Vault (kv/budget-tracker). .env är ignorerad av git.
POSTGRES_DB=budget_app
POSTGRES_USER=postgresql
POSTGRES_PASSWORD=
CONNECTION_STRING=Host=db;Port=5432;Database=budget_app;Username=postgresql;Password=samma-som-POSTGRES_PASSWORD

# Bara för docker-compose.dev.yml (pgAdmin)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Lokalt: hoppa över inloggningen (fungerar bara när ASPNETCORE_ENVIRONMENT=Development)
# DISABLE_AUTH=true
